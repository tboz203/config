# inputrc - readline rc file

$include /etc/inputrc

set editing-mode vi

set keymap vi-move
"gg": end-of-history

set keymap vi-insert
"\C-l": clear-screen
"\e[Z": menu-complete
"jk": vi-movement-mode

# this is a great idea, but 1) it gets lots of false positives (thinking things
# are files that are not files), and 2) anything that's *not* a file gets the
# `MISSING` ls color, which by default, ... is *blinking*
set colored-stats on
set completion-ignore-case on

# ---

"\C-p": "bad "
"\C-n": "bad "
