# inputrc - readline rc file

$include /etc/inputrc

set editing-mode vi

# Change cursor shape for different modes
set show-mode-in-prompt
# 1. Block cursor for Command mode
set vi-cmd-mode-string \1\e[2 q\2
# 2. Beam/Vertical bar cursor for Insert mode
set vi-ins-mode-string \1\e[6 q\2

set keymap vi-move
"gg": end-of-history

set keymap vi-insert
"\C-l": clear-screen
"\e[Z": menu-complete
"jk": vi-movement-mode

set colored-stats on
set completion-ignore-case on

# ---

"\C-p": previous-history
"\C-n": next-history
