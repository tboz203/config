; vim: filetype=gitconfig tabstop=4 shiftwidth=0 softtabstop=-1 noexpandtab
[user]
	name = Bozeman, Thomas (CGI Federal)
	email = thomas.bozeman@uspto.gov

[core]
	editor = nvim
	excludesfile = ~/.gitignore
	untrackedCache = true

[branch]
	autoSetupMerge = simple
[checkout]
	defaultRemote = origin
[column]
	; ui = auto column dense
	tag = auto column dense
[diff]
	tool = nvimdiff
	algorithm = histogram
	colorMoved = default
	whitespace = ignore
[difftool]
	; tool itself goes in `diff`
	prompt = false
	trustExitCode = true
[fetch]
	recursesubmodules = on-demand
	prune = true
[init]
	; templatedir = ~/.git_template
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[log]
	date = relative
	initialDecorationSet = all
[mailmap]
	file = ~/.git-mailmap
[merge]
	tool = nvimdiff
	; conflictstyle = diff3
	; conflictstyle = zdiff3
	ff = false
[mergetool]
	; tool itself goes in `merge`
	prompt = false
	keepBackup = false
	hideResolved = true
[pull]
	ff = only
[push]
	default = current
	recurseSubmodules = on-demand
[rebase]
	autoStash = true
	autoSquash = true
	rebaseMerges = true
	missingCommitsCheck = error
	# keeping this off in order to isolate changes
	# use the cli flag when its safe to do so
	updateRefs = false
[rerere]
	enabled = true
[revert]
	reference = true
[tag]
	sort = version:refname

[core]
	pager = add-this-command-to-the-gitconfig-pager-list
[pager]
	branch = less
	config = less
	diff = delta
	log = less
	shortlog = less
	show = delta

[pretty]
	myline = %C(auto)%h %C(cyan)%aN %C(green)%ad%C(auto)%d %s
	myshort = %C(auto)%h %C(cyan)%aN %C(green)%ad%C(auto)%d%n%s
	long = %C(auto)%h %C(cyan)%aN %C(green)%ad%C(auto)%d%n%s%n%n%-b
	; long = %C(auto)%h %C(cyan)%aN %C(green)%ad%C(auto)%d%n%s%n%n%w(0,4,4)%b
	loud = %C(auto)%h %C(cyan)%aN %C(green)%ad%C(auto)%d %C(black brightyellow)%s%C(reset)
	myshort = %C(auto)%h %C(cyan)%aN %C(green)%ad%C(auto)%d%n%s
	committer = %C(auto)%h %C(cyan)%aN %C(green)%ad %C(reset)(%C(blue)%cN %C(red)%cd%C(reset))%C(auto)%d %s
	contrast = %C(black blue)commit %h %aN %ad%d %s%n%B
	; no colors here b/c `column` can't count characters correctly
	tableable = & %h & %aN & %ad & %<(80,trunc)%s & %d
	reflog = %C(auto)%h %C(green)%gd%C(auto)%d %C(blue)[%gs] %C(auto)%s
	report = %C(auto)commit %h%d%nAuthor: %aN <%aE>%nDate: %ad%n%n%w(80,4,4)%B%n
	delta = %C(auto)commit %h %C(cyan)%aN %C(green)%ad%C(auto)%d %s

[alias]
	s = status
	si = status --ignored
	d = diff --stat
	ds = diff --staged
	l = log --graph --date-order --date=relative --pretty=myline
	la = l --branches --tags --remotes=origin HEAD
	laa = l --all
	ll = l --date=human --format=long
	lla = ll --branches --remotes=origin
	llaa = ll --all
	lr = l --remotes=origin
	lg = log --walk-reflogs --format=reflog
	lgd = lg --date=relative
	ls = la --simplify-by-decoration
	logpath = l --boundary --ancestry-path
	lp = logpath
	ld = log --pretty=delta --no-graph --reverse --stat
	logdiff = ld --patch
	lw = watch l
	lwa = watch la
	logwatch = lwa
	rs = for-each-ref --format='%(refname:short)'
	rsf = for-each-ref --format='%(refname)'
	; clean up local repository metadata
	scrub = !git reflog expire --expire-unreachable=now --all && git gc --prune=now
	; clean up local workspace
	purge = !git reset --hard && git clean -ffqdx 
	; create a "checkpoint" commit
	checkpoint = !git commit -am \"checkpoint `date +%Y-%m-%d`\"

; [color "diff"]
; 	meta = "bold #000000 brightblue"
; 	frag = "bold #000000 yellow"
[delta]
	dark = true
	syntax-theme = Catppuccin Macchiato
	line-numbers = true
	commit-decoration-style = white blue ol
	hunk-header-style = file line-number syntax

[include]
	path = ~/.gitconfig.site
