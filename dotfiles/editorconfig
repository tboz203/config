; .editorconfig

root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
; indent_size = 4
trim_trailing_whitespace = true
max_line_length = 119

; for shfmt
switch_case_indent = true
space_redirects = true

[*.{js,json,lua}]
indent_size = 2

[*.{py,sh}]
indent_size = 4
