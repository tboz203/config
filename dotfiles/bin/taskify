#!/usr/bin/env bash

# Scriptlet to help sanitize commands for cron.

source ~/.bash_profile

die() {
    echo "$SELF: ${*:-Fatal Error}" | tee >&2 -a "${LOG:-/dev/null}"
    exit 1
}

SELF=$(basename "$0")

ARGS=$(
    getopt \
        -o 'hs:qvl:d:L:S:' \
        --long 'help,random-sleep:,quiet,verbose,log:,directory:,longer-than:,shorter-than:' \
        -n "$SELF" \
        -- "$@"
) || die "Halting for invalid arguments"
eval set -- "$ARGS" && unset ARGS

declare HELP
declare SLEEP LOGFILE DIRECTORY CHECK_LONGER CHECK_SHORTER
declare COMMAND

declare VOLUME=3

while (($#)); do
    case $1 in
        -h | --help) HELP=1 && shift ;;
        -s | --random-sleep) SLEEP=$2 && shift 2 ;;
        -q | --quiet) ((VOLUME--)) && shift ;;
        -l | --log) LOGFILE=$2 && shift 2 ;;
        -d | --directory) DIRECTORY=$2 && shift 2 ;;
        -L | --longer-than) CHECK_LONGER=$2 && shift 2 ;;
        -S | --shorter-than) CHECK_SHORTER=$2 && shift 2 ;;
        --) shift && break ;;
        *) break ;;
    esac
done

COMMAND=("$@")

if [[ ${HELP-} ]]; then
    cat << EOF
Usage: $SELF [OPTIONS] [--] COMMAND ...

Sanitize commands for cron.

Arguments:
COMMAND                 The command to run, with arguments

Options:
-h | --help     Print out this message.
-q | --quiet    Silence the command, unless it exits with an error (to prevent
                useless cron emails from chatty programs). Can be given more
                than once to also silence errors
-l | --log LOG  Append any output to LOG as well (includes timestamp & exit
                code; path LOG is *not* relative to --directory argument)
-s | --random-sleep SLEEP
                Sleep for a random duration up to SLEEP seconds before
                executing the command (to prevent load spikes at midnight,
                etc).
-S | --shorter-than DURATION
                If the command executes for fewer seconds than DURATION, 
-d | --directory DIRECTORY
                change to DIRECTORY before executing command
EOF

    exit
fi

[[ -v COMMAND ]] || die 'no command given'

if [[ ${SLEEP-} ]]; then
    sleep $((RANDOM % SLEEP))
fi

if [[ ${DIRECTORY-} ]]; then
    pushd "$DIRECTORY" &> /dev/null || die "could not change directory to ($DIRECTORY)"
fi

starttime=$EPOCHSECONDS
output=$("${COMMAND[@]}" 2>&1)
exit_code=$?
stoptime=$EPOCHSECONDS

if [[ ! ${output-} ]]; then
    empty=1
    output="[.] no output"
fi

output+=$'\n'
output+="[.] exit code: $exit_code"

duration=$((stoptime - starttime))

if [[ ${CHECK_LONGER-} && $duration -gt $CHECK_LONGER ]]; then
    TOOK_LONGER=1
fi

if [[ ${CHECK_SHORTER-} && $duration -le $CHECK_SHORTER ]]; then
    TOOK_SHORTER=1
fi

if [[ ${TOOK_LONGER-} || ${TOOK_SHORTER-} ]]; then
    output+=$'\n'
    output+="[.] duration: $duration"
    VOLUME=3
fi

if [[ ${DIRECTORY-} ]]; then
    popd &> /dev/null || die "could not return to starting directory"
fi

if [[ ($VOLUME -gt 2 && ! ${empty-}) || ($VOLUME -gt 1 && $exit_code -ne 0) ]]; then
    echo "$output"
fi

if [[ ${LOGFILE-} ]]; then
    {
        echo "[.] date: $(date +%c)"
        echo "[$] $(quoted "${COMMAND[@]}" | tr '\n' ' ')"
        echo "$output"
    } >> "$LOGFILE"
fi

exit $exit_code
