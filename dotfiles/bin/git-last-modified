#!/usr/bin/env bash

# show the git last modified time of files in the current directory

git ls-tree --format='%(objecttype) %(path)' HEAD "${@:-.}" |
    sed -r -e 's:^tree .*:&/:' -e 's:^(tree|blob) ::' |
    xargs -I{} \
        git log -1 --color --format="%aI@%C(green)%ad@%C(cyan)%an@%C(reset){}" -- {} |
    sort |
    cut -d@ -f2- |
    column -t -s@ -C right -d -o' '
