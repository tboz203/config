-- \set index_usage_adv 'with index_stats as (select r.*, indexrelname, r.seq_scan :: real / nullif(r.seq_scan + i.idx_scan, 0) as single_index_miss_rate, r.seq_scan :: real / nullif(r.seq_scan + r.idx_scan, 0) as total_index_miss_rate, array(select pg_get_indexdef(idx.indexrelid, k + 1, true) from generate_subscripts(idx.indkey, 1) as k order by k) as cols from pg_stat_user_tables r join pg_stat_user_indexes i using (relid) join pg_index as idx using (indexrelid)) select schemaname as schema, relname as table, indexrelname as index, round((100.0 * single_index_miss_rate) :: numeric, 3) as single_index_miss_rate, n_live_tup * single_index_miss_rate as single_index_miss_cost, round((100.0 * total_index_miss_rate) :: numeric, 3) as total_index_miss_rate, n_live_tup * total_index_miss_rate as full_index_miss_cost, n_live_tup as rowcount, cols, now() - last_vacuum as since_last_manual_vacuum, now() - last_autovacuum as since_last_autovacuum, now() - last_analyze as since_last_manual_analyze, now() - last_autoanalyze as since_last_autoanalyze from index_stats where schemaname = current_schema order by n_live_tup * total_index_miss_rate desc nulls last, single_index_miss_rate desc limit 30;'

-- Development queries

\set sp 'show search_path;'
\set ll '\\! ls -lrt;'

\unset QUIET
