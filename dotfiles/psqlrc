-- https://github.com/datachomp/dotfiles/blob/master/.psqlrc
-- with -minor- some modifications
-- vim: ft=sql commentstring=--\ %s

\set QUIET 1
-- formatting
\x auto

\set VERBOSITY verbose
\set ON_ERROR_ROLLBACK interactive
-- show queries emmitted by PSQL meta-commands
-- \set ECHO_HIDDEN on
-- show execution times
\timing
-- replace nulls
-- \pset null ¤
-- U+200B is zero-width space; compensation for double-width emoji for things
-- that don't know about emoji
\pset null ❌​
\pset linestyle unicode
\pset border 2
\pset numericlocale on

-- colorize
\set PROMPT1 '%[%033[1m%]%M %n@%/%R%[%033[0m%]%# '
\set PROMPT2 '[more] %R > '

-- logging
-- Use a separate history file per-database.
\set HISTFILE ~/.psql_history- :DBNAME
-- If a command is run more than once in a row, only store it once in the
-- history.
\set HISTCONTROL ignoredups

-- Autocomplete keywords (like SELECT) in upper-case, even if you started
-- typing them in lower case.
-- \set COMP_KEYWORD_CASE upper

-- helpful queries
\set uptime 'select now() - backend_start as uptime from pg_stat_activity where pid = pg_backend_pid();'
\set slow_queries 'select (total_time / 1000 / 60) as total_minutes, (total_time/calls) as average_time, query from pg_stat_statements order by 1 desc limit 100;'
\set settings 'select name, setting,unit,context from pg_settings;'
\set conninfo 'select usename, count(*) from pg_stat_activity group by usename;'
\set activity 'select datname, pid, usename, application_name,client_addr, client_hostname, client_port, query, state from pg_stat_activity;'
\set waits 'select pg_stat_activity.pid, pg_stat_activity.query, pg_stat_activity.waiting, now() - pg_stat_activity.query_start as "totaltime", pg_stat_activity.backend_start from pg_stat_activity where pg_stat_activity.query !~ ''%idle%''::text and pg_stat_activity.waiting = true;'

\set _table_size '(select relkind, relnamespace::regnamespace::text as schema, relname as relation, reltuples::bigint as rowcount, pg_size_pretty(pg_table_size(oid)) as table_size, pg_size_pretty(pg_indexes_size(oid)) as indexes_size, pg_size_pretty(pg_total_relation_size(oid)) as total_size from pg_class where relkind in (''r'', ''m'', ''f'', ''p'') and relnamespace::regnamespace not in (''information_schema'', ''pg_catalog'') order by pg_total_relation_size(oid) desc)'
\set table_size 'select * from :_table_size t1 limit 30;'
\set my_table_size 'select * from :_table_size t1 where schema = current_schema limit 30;'
\set _index_size '(with index_sizes as (select pg_total_relation_size(indexrelid) as size, * from pg_index order by 1 desc nulls last), index_rows as (select indrelid, string_agg(format(''%10s - %s '', pg_size_pretty(size), indexrelid::regclass), chr(10)) as index_sizes from index_sizes group by indrelid) select relnamespace::regnamespace::text as schema, relname as table_name, reltuples::bigint as rowcount, pg_size_pretty(pg_indexes_size(oid)) as total_index_size, pg_size_pretty(pg_total_relation_size(oid)) as total_relation_size, index_sizes from pg_class r join index_rows i on r.oid = i.indrelid order by pg_indexes_size(oid) desc)'
\set index_size 'select * from :_index_size t1 limit 30;'
\set my_index_size 'select * from :_index_size t1 where schema = current_schema limit 30;'
\set schema_size 'select relnamespace::regnamespace::name as schema, count(*) as count_tables, sum(reltuples)::bigint as count_rows, pg_size_pretty(sum(pg_table_size(oid))) as size_tables, pg_size_pretty(sum(pg_indexes_size(oid))) as size_indexes, pg_size_pretty( sum(pg_total_relation_size(oid))) as size_total from pg_class where relkind in (''r'', ''m'', ''f'', ''p'') group by relnamespace order by sum(pg_total_relation_size(oid)) desc nulls last;'
\set db_size 'with db_sizes as (select datname as database, case when has_database_privilege(datname, ''connect'') then pg_database_size(datname) else null end as size_bytes from pg_database) select database, pg_size_pretty(size_bytes) as size from (select * from db_sizes union all select ''* total'', sum(size_bytes) from db_sizes) t1 order by size_bytes desc nulls last;'

\set _index_usage '(with ratios as ( select relid, seq_scan::numeric / nullif(idx_scan, 0) as scan_ratio from pg_stat_user_tables) select schemaname, relname as table_name, seq_scan, idx_scan, round(scan_ratio, 2) as scan_ratio, n_live_tup as rowcount, round(n_live_tup * scan_ratio, 2) as cost from pg_stat_user_tables t join ratios s using (relid) where n_live_tup > 100 order by cost desc, rowcount desc)'
\set index_usage 'select * from :_index_usage t1 limit 30;'
\set my_index_usage 'select * from :_index_usage t1 where schemaname = current_schema limit 30;'

\set _useless_columns '(select schemaname, tablename, attname, null_frac, n_distinct, reltuples::bigint as rowcount, case when coalesce(cardinality(most_common_vals), 0) <= 10 then most_common_vals::text else ''...'' end as most_common_vals from pg_stats s join pg_class c on ( c.relname = s.tablename and c.relnamespace::regnamespace::name = s.schemaname) where null_frac = 1 or n_distinct = 1 order by 1, 2)'
\set useless_columns 'select * from :_useless_columns t1 limit 30;'
\set my_useless_columns 'select * from :_useless_columns t1 where schemaname = current_schema limit 30;'

\set _constraint_index_links '(select c.oid as constraint, i.indexrelid as index from pg_constraint c full join pg_index i on (c.conrelid = i.indrelid and conkey = (select array_agg(k) from unnest(i.indkey) as k limit i.indnkeyatts)))'

\set _index_usage_all '(with ratios as (select relid, indexrelid, i.idx_scan as current_idx_scan, t.seq_scan::numeric / nullif(i.idx_scan, 0) as current_ratio, t.seq_scan::numeric / nullif(t.idx_scan, 0) as total_ratio from pg_stat_user_indexes i join pg_stat_user_tables t using (relid)) select schemaname, indrelid::regclass as table, indexrelid::regclass as index, seq_scan, current_idx_scan as idx_scan, round(current_ratio, 2) as current_ratio, round(total_ratio, 2) as total_ratio, n_live_tup as rowcount, round(n_live_tup * current_ratio, 2) as current_cost, round(n_live_tup * total_ratio, 2) as total_cost from pg_index i join ratios r using (indexrelid) join pg_stat_user_tables s using (relid) where n_live_tup > 100 order by current_cost desc, total_cost desc, rowcount desc)'
\set _index_usage_adv 'select schemaname, (select relname from pg_class where oid = "table") as table_name, (select relname from pg_class where oid = index) as index_name, seq_scan, idx_scan, current_ratio, total_ratio, rowcount, current_cost, total_cost from :_index_usage_all t1'
\set index_usage_adv ':_index_usage_adv limit 30;'
\set my_index_usage_adv ':_index_usage_adv where schemaname = current_schema limit 30;'

-- \set _useless_indexes '(select s.schemaname, pg_get_indexdef(s.indexrelid, 0, True) as index_definition, r.reltuples::bigint as rowcount, s.idx_scan as scans, round(s.idx_scan / nullif(t.seq_scan, 0)::numeric, 2) as current_scan_ratio, round(t.idx_scan / nullif(t.seq_scan, 0)::numeric, 2) as full_scan_ratio, c.confrelid::regclass::name as foreign_table, pg_size_pretty(pg_table_size(s.relid)) as table_size, pg_size_pretty(pg_table_size(s.indexrelid)) as current_index_size, pg_size_pretty(pg_indexes_size(s.relid)) as total_index_size from pg_stat_user_tables t join pg_class r on t.relid = r.oid left join pg_stat_user_indexes s using (relid) left join pg_index i using (indexrelid) left join pg_constraint c on ( i.indrelid = c.conrelid and c.conkey <@ ( select array_agg(id) from unnest(i.indkey) as id limit i.indnkeyatts)) where not i.indisunique and r.reltuples::bigint > 100 and ( s.idx_scan / nullif(t.seq_scan, 0)::float < 2 or t.idx_scan / nullif(t.seq_scan, 0)::float < 10) order by s.idx_scan asc, pg_relation_size(s.relid) desc)'
\set _useless_indexes '(with index_usage as (:_index_usage_all), constraint_index_links as (:_constraint_index_links) select schemaname, pg_get_indexdef(indexrelid, 0, true) as index_definition, seq_scan, current_ratio, total_ratio, rowcount, current_cost, total_cost from pg_index i join index_usage u on i.indexrelid = u.index left join constraint_index_links l on i.indexrelid = l.index where not indisunique and l.constraint is null and rowcount > 100 order by current_cost desc)'
\set useless_indexes 'select * from :_useless_indexes t1 limit 30;'
\set my_useless_indexes 'select * from :_useless_indexes t1 where schemaname = current_schema limit 30;'

\set _missing_indexes '(select connamespace::regnamespace::text as schema, conrelid::regclass::text as src_table, confrelid::regclass::text as dst_table, conname as fk_name, indexrelid::regclass as index, (select string_agg(attname, '', '') from pg_attribute where attrelid = conrelid and attnum = any(conkey)) as columns, src.reltuples::bigint as src_rowcount, pg_size_pretty(pg_total_relation_size(conrelid)) as src_size, dst.reltuples::bigint as dst_rowcount, pg_size_pretty(pg_total_relation_size(confrelid)) as dst_size from pg_constraint c join pg_class src on c.conrelid = src.oid join pg_class dst on c.confrelid = dst.oid left join pg_index i on c.conrelid = i.indrelid and conkey = (select array_agg(id) from unnest(i.indkey) as id limit i.indnkeyatts) where contype = ''f'')'
\set missing_indexes 'select * from :_missing_indexes t1 where index is null order by src_table, dst_table limit 30;'
\set my_missing_indexes 'select src_table, dst_table, fk_name, index, columns, src_rows, src_size, dst_rows, dst_size from :_missing_indexes t1 where schema = current_schema order by index is null desc, src_table, dst_table limit 30;'

-- Taken from https://github.com/heroku/heroku-pg-extras
-- via https://github.com/dlamotte/dotfiles/blob/master/psqlrc
\set bloat 'select schemaname, tablename, round(case when otta=0 then 0.0 else sml.relpages/otta::numeric end,1) as table_bloat, case when relpages < otta then ''0'' else pg_size_pretty((bs*(sml.relpages-otta)::bigint)::bigint) end as table_waste, iname as index_name, round(case when iotta=0 or ipages=0 then 0.0 else ipages/iotta::numeric end,1) as index_bloat, case when ipages < iotta then ''0'' else pg_size_pretty((bs*(ipages-iotta))::bigint) end as index_waste from (select schemaname, tablename, cc.reltuples, cc.relpages, bs, ceil((cc.reltuples*((datahdr+ma- (case when datahdr%ma=0 then ma else datahdr%ma end))+nullhdr2+4))/(bs-20::float)) as otta, coalesce(c2.relname,''?'') as iname, coalesce(c2.reltuples,0) as ituples, coalesce(c2.relpages,0) as ipages, coalesce(ceil((c2.reltuples*(datahdr-12))/(bs-20::float)),0) as iotta from (select ma,bs,schemaname,tablename, (datawidth+(hdr+ma-(case when hdr%ma=0 then ma else hdr%ma end)))::numeric as datahdr, (maxfracsum*(nullhdr+ma-(case when nullhdr%ma=0 then ma else nullhdr%ma end))) as nullhdr2 from (select schemaname, tablename, hdr, ma, bs, sum((1-null_frac)*avg_width) as datawidth, max(null_frac) as maxfracsum, hdr+(select 1+count(*)/8 from pg_stats s2 where null_frac<>0 and s2.schemaname = s.schemaname and s2.tablename = s.tablename) as nullhdr from pg_stats s, (select (select current_setting(''block_size'')::numeric) as bs, case when substring(v,12,3) in (''8.0'',''8.1'',''8.2'') then 27 else 23 end as hdr, case when v ~ ''mingw32'' then 8 else 4 end as ma from (select version() as v) as foo) as constants group by 1,2,3,4,5) as foo) as rs join pg_class cc on cc.relname = rs.tablename join pg_namespace nn on cc.relnamespace = nn.oid and nn.nspname = rs.schemaname and nn.nspname not in (''information_schema'', ''pg_catalog'') left join pg_index i on indrelid = cc.oid left join pg_class c2 on c2.oid = i.indexrelid) as sml order by case when relpages < otta then 0 else bs*(sml.relpages-otta)::bigint end desc;'
\set blocking 'select bl.pid as blocked_pid, ka.query as blocking_statement, now() - ka.query_start as blocking_duration, kl.pid as blocking_pid, a.query as blocked_statement, now() - a.query_start as blocked_duration from pg_catalog.pg_locks bl join pg_catalog.pg_stat_activity a on bl.pid = a.pid join pg_catalog.pg_locks kl join pg_catalog.pg_stat_activity ka on kl.pid = ka.pid on bl.transactionid = kl.transactionid and bl.pid != kl.pid where not bl.granted;'
\set cache_hit 'select ''index hit rate'' as name, (sum(idx_blks_hit)) / sum(idx_blks_hit + idx_blks_read) as ratio from pg_statio_user_indexes union all select ''cache hit rate'' as name, sum(heap_blks_hit) / (sum(heap_blks_hit) + sum(heap_blks_read)) as ratio from pg_statio_user_tables;'
\set locks 'select pg_stat_activity.pid, pg_class.relname, pg_locks.transactionid, pg_locks.granted, substr(pg_stat_activity.query,1,30) as query_snippet, age(now(),pg_stat_activity.query_start) as "age" from pg_stat_activity,pg_locks left outer join pg_class on (pg_locks.relation = pg_class.oid) where pg_stat_activity.query <> ''<insufficient privilege>'' and pg_locks.pid=pg_stat_activity.pid and pg_locks.mode = ''ExclusiveLock'' order by query_start;'
\set long_running_queries 'select pid, now() - pg_stat_activity.query_start as duration, query as query from pg_stat_activity where pg_stat_activity.query <> ''''::text and now() - pg_stat_activity.query_start > interval ''5 minutes'' order by now() - pg_stat_activity.query_start desc;'
\set ps 'select pid, application_name as source, age(now(),query_start) as running_for, waiting, query as query from pg_stat_activity where query <> ''<insufficient privilege>'' and state <> ''idle'' and pid <> pg_backend_pid() order by 3 desc;'
\set seq_scans 'select relname as name, seq_scan as count from pg_stat_user_tables order by seq_scan desc;'
