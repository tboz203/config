# inputrc - readline rc file

$include /etc/inputrc

set editing-mode vi

set keymap vi-move
"gg": end-of-history

set keymap vi-insert
"\C-l": clear-screen
"\e[Z": menu-complete
"jk": vi-movement-mode

set colored-stats on
set completion-ignore-case on

# ---

"\C-p": previous-history
"\C-n": next-history
