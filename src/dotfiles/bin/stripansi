#!/usr/bin/env python3

import fileinput
import re

# ANSI_PATTERN = re.compile(
#     r"""
#     \x1b\[                  # ANSI escape sequences start with an ASCII escape
#                             # character followed by an open bracket
#     (
#         [0-9]*(;[0-9]*)*m   # color and graphics directives
#         | [0-9]*[A-G]       # cursor movement
#         | [0-9]+;[0-9]+H    # set cursor position
#         | [0-9]*[JK]        # erase
#     )
#     """,
#     re.VERBOSE
# )


ANSI_PATTERN = re.compile(r"\x1b\[[^A-Za-z]*[A-Za-z]")


def stripansi(data: str):
    return ANSI_PATTERN.sub("", data)


if __name__ == "__main__":
    with fileinput.input(encoding="utf-8") as lines:
        for line in lines:
            print(stripansi(line), end="")
