#!/bin/bash -eu

# move to script directory
cd $(dirname $0)

CONFIG_ROOT=$(pwd)

# remove everything we collide with beforehand to prevent errors
./unwire

for repo_file in ./dotfiles/*; do
    dot_file=~/.$(basename $repo_file)
    ln -s --relative $repo_file $dot_file
done

